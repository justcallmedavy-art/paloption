# Daraja / M-Pesa credentials.
#
# Copy this file to `.env.local` and fill it in. `.env.local` is git-ignored and
# is read by tools/server.mjs at startup, so no credential ever needs to live in
# a tracked file, a shell command, or a chat message.
#
#   cp .env.local.example .env.local
#
# A variable already present in the environment wins over this file, so a shell
# can override any of these without editing anything.

# --- Daraja app (developer.safaricom.co.ke -> your app) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Your business shortcode, and the Lipa na M-Pesa passkey for it.
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# --- Sandbox defaults, if your portal shows the same values ---
# The passkey is the publicly documented sandbox one; confirm it in your portal
# rather than trusting this comment. The sandbox test MSISDN is 254708374149.
# DARAJA_SHORTCODE=174379
# DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# --- The result callback ---
# Safaricom cannot reach localhost, so the callback must be a public HTTPS URL,
# and the path must carry DARAJA_CALLBACK_TOKEN. The token is the only thing
# making this public route safe, so keep it long and random.
#
#   DARAJA_CALLBACK_URL=https://<your-tunnel>.trycloudflare.com/api/auth/mpesa/callback/<token>
#
# Build it from the origin of whatever exposes this server:
#   node -e "const c=require('crypto');console.log(c.randomBytes(24).toString('hex'))"
DARAJA_CALLBACK_TOKEN=
DARAJA_CALLBACK_URL=

# --- Which Safaricom environment to talk to ---
# sandbox -> sandbox.safaricom.co.ke, production -> api.safaricom.co.ke
DARAJA_ENV=sandbox

# --- Paybill or till? One field apart ---
# buygoods sends CustomerBuyGoodsOnline with the till number in PartyB;
# anything else sends CustomerPayBillOnline with the shortcode in PartyB.
#
# Sandbox is a paybill: 174379 is a lipa na m-pesa paybill shortcode, and the
# sandbox is not set up for a Buy Goods request against it. Flip to buygoods and
# set DARAJA_PARTY_B to the till number only when going live on a till.
DARAJA_TRANSACTION_TYPE=paybill
DARAJA_PARTY_B=

# --- The USDT (TRC20) wallet ---
# The one setting here that moves money. Left unset, the server uses a wallet
# built into the source (DEFAULT_TRON_DEPOSIT_ADDRESS) that is not yours, and
# every account is shown it. Set it to an address you control, or to an empty
# string to switch the static wallet off (the route then answers 503 rather
# than quoting an address nobody here can spend from).
#
#   TRON_DEPOSIT_ADDRESS=TYourOwnAddressHere
TRON_DEPOSIT_ADDRESS=

# --- Deployment: how the pieces find each other ---
#
# The backend needs a database. Without DATABASE_URL the server runs its ledger
# in memory, which is fine for a local run and refused in production (NODE_ENV=
# production or REQUIRE_DATABASE_URL=1 makes an absent DATABASE_URL a boot
# error, so a deploy cannot silently lose every trade on restart).
#
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Where the frontend lives. Until this is set the client stays same-origin
# (each request goes to the host serving the page). With the frontend on Vercel
# and the API elsewhere, the API host MUST be listed here or the browser blocks
# the request — and the server refuses it with ORIGIN_NOT_ALLOWED. Comma
# separated; no trailing slashes.
#
#   ALLOWED_ORIGINS=https://paloption.vercel.app
ALLOWED_ORIGINS=

# Baked into the frontend so it calls the API host rather than its own. Also
# accepted as VITE_API_URL. An https value yields a wss:// socket.
#
#   PALOPTION_API_URL=https://paloption-api.onrender.com
PALOPTION_API_URL=

# Port to listen on. Most hosts set PORT themselves; the default is 4174.
# PORT=

# Set to production on a real deployment. It requires DATABASE_URL and stops the
# server from falling back to the in-memory ledger.
# NODE_ENV=production

# --- LIVE M-Pesa: a second switch, on purpose ---
#
# DARAJA_ENV=production charges a real shortcode: real STK prompts, real customer
# PINs, real money into the operator wallet. It is ignored unless this is exactly
# "1", so a copied configuration cannot start taking real payments by accident.
#
# DARAJA_ALLOW_PRODUCTION=1
